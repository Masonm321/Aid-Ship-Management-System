<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.utsa.cs3443.Lec127_lab4.MainScreenController"
      alignment="CENTER"
      spacing="12"
      prefWidth="650"
      prefHeight="650"
      style="-fx-background-color: #f4f7fb;">

    <padding>
        <Insets top="20" right="20"
                bottom="20" left="20"/>
    </padding>

    <ImageView fitWidth="250"
               fitHeight="120"
               preserveRatio="true">
        <image>
            <Image url="@../images/logo.png"/>
        </image>
    </ImageView>

    <Label text="The Global Emergency Response Organization"
           style="-fx-font-size: 19px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #17365d;"/>

    <Button text="List Ships"
            fx:id="listShipsButton"
            prefWidth="120"/>

    <Label text="Sort Ships By:"
           style="-fx-font-size: 13px;
                  -fx-font-weight: bold;"/>

    <HBox alignment="CENTER" spacing="20">

        <RadioButton text="Ship Name"
                     fx:id="sortNameRadioButton"/>

        <RadioButton text="Registration Number"
                     fx:id="sortRegistrationRadioButton"/>

    </HBox>

    <Label text="Registration Number:"/>

    <TextArea fx:id="registrationNumberArea"
              prefRowCount="1"
              maxWidth="250"/>

    <HBox alignment="CENTER" spacing="20">

        <RadioButton text="Find"
                     fx:id="findRadioButton"/>

        <RadioButton text="Delete"
                     fx:id="deleteRadioButton"/>

    </HBox>

    <Button text="Go!"
            fx:id="goButton"
            prefWidth="80"/>

    <TextArea fx:id="resultsArea"
              editable="false"
              prefHeight="170"
              wrapText="true"/>

    <Button text="Logout"
            fx:id="logoutButton"
            prefWidth="120"
            style="-fx-background-color: #17365d;
                   -fx-text-fill: white;
                   -fx-font-size: 13px;"/>

    <Label text="© 2026 GERO - Aid Ship Management System"
           style="-fx-font-size: 11px;
                  -fx-text-fill: #555555;"/>

</VBox>
